{
  "name": "byobyaml",
  "productName": "BYOBYaml",
  "version": "0.1.0",
  "description": "Build Your Own Blocks YAML - Scratch-style block builder for Docker Compose, Kubernetes and OpenShift configs",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "app": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win nsis portable",
    "dist:portable": "vite build && electron-builder --win portable",
    "check": "tsc --noEmit && bun scripts/roundtrip.ts",
    "postinstall": "node node_modules/electron/install.js",
    "docs:gen": "bun scripts/gen-docs.ts",
    "docs:dev": "bun scripts/gen-docs.ts && cd docs-site && bun run start",
    "docs:build": "bun scripts/gen-docs.ts && cd docs-site && bun run build",
    "docs:serve": "cd docs-site && bun run serve",
    "docs:screens": "vite build && node scripts/run-screenshots.cjs"
  },
  "build": {
    "appId": "dev.byobyaml.app",
    "productName": "BYOBYaml",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@blockly/field-multilineinput": "13.4.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "blockly": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "trustedDependencies": [
    "electron"
  ]
}
